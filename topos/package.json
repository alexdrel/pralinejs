{
  "name": "topos-praline",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "generate": "node node_modules/@alexdrel/pralinejs/dist/cli.js --emit dts editor",
    "precheck": "npm run generate",
    "check": "tsc",
    "lint": "oxlint --deny-warnings .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test:unit": "node --test editor",
    "test": "npm run check && npm run lint && npm run fmt:check && npm run test:unit"
  },
  "dependencies": {
    "@alexdrel/pralinejs": "file:..",
    "@alexdrel/jsonml-ts": "^0.6.0",
    "@alexdrel/perky": "^0.2.0"
  }
}
